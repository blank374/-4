# Local archives and temporary experiments (kept on disk)
/_local_archive/
/tmp/

# Ignore experimental outputs by default; retain selected research artifacts.
/results/
/results_*/
/result[1-4]_*.csv

# Formal answers and the evidence needed to independently audit them.
!/results_task1/
/results_task1/*
!/results_task1/result1_*.csv

!/results_task2_exact/
/results_task2_exact/*
!/results_task2_exact/result2_*.csv
