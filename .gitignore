!/results_task2_exact/verification_report.json
!/results_task2_exact/server_input_manifest.json
!/results_task2_exact/.task2_exact/
/results_task2_exact/.task2_exact/*
!/results_task2_exact/.task2_exact/*.exact

!/results_task3_certified/
/results_task3_certified/*
!/results_task3_certified/result3_*.csv
!/results_task3_certified/aggregation.json
!/results_task3_certified/selection.json
!/results_task3_certified/verification_report.json
!/results_task3_certified/checkpoints/
/results_task3_certified/checkpoints/*
!/results_task3_certified/checkpoints/*.json

!/results_task4/
